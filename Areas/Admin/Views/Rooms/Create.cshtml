@model AdminRoomFormViewModel
@{
    ViewData["Title"] = "Add New Room";
}

<div class="summary-card" style="max-width: 780px;">
    <form asp-area="Admin" asp-controller="Rooms" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="RoomNumber" class="form-label small fw-semibold"></label>
                <input asp-for="RoomNumber" class="form-control" />
                <span asp-validation-for="RoomNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label small fw-semibold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="RoomType" class="form-label small fw-semibold"></label>
                <select asp-for="RoomType" asp-items="Html.GetEnumSelectList<RoomType>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="PricePerNight" class="form-label small fw-semibold"></label>
                <input asp-for="PricePerNight" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PricePerNight" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Capacity" class="form-label small fw-semibold"></label>
                <input asp-for="Capacity" type="number" min="1" max="20" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BedType" class="form-label small fw-semibold"></label>
                <input asp-for="BedType" class="form-control" />
                <span asp-validation-for="BedType" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="RoomStatus" class="form-label small fw-semibold"></label>
                <select asp-for="RoomStatus" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="form-select"></select>
            </div>
            <div class="col-12">
                <label asp-for="ImageUrl" class="form-label small fw-semibold"></label>
                <input asp-for="ImageUrl" class="form-control" placeholder="/images/rooms/deluxe-204.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Amenities" class="form-label small fw-semibold"></label>
                <input asp-for="Amenities" class="form-control" placeholder="Free Wi-Fi, Air Conditioning, Smart TV" />
                <span asp-validation-for="Amenities" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label small fw-semibold"></label>
                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-hotel-primary">Save Room</button>
            <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-hotel-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
