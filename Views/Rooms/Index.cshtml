@using HotelBookingSystem.Models.Enums
@model HotelBookingSystem.ViewModels.RoomSearchViewModel
@{
    ViewData["Title"] = "Rooms & Suites";
    var minCheckIn = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
}

<section class="container py-5">
    <div class="mb-4">
        <p class="eyebrow mb-1">Accommodations</p>
        <h1 class="display-5 mb-2">Rooms &amp; Suites</h1>
        <p class="text-muted mb-0">Filter by your travel dates, party size, or preferred room category.</p>
    </div>

    <div class="summary-card mb-5">
        <form asp-controller="Rooms" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label asp-for="CheckInDate" class="form-label small fw-semibold text-muted"></label>
                <input asp-for="CheckInDate" type="date" min="@minCheckIn" class="form-control" data-date-checkin />
                <span asp-validation-for="CheckInDate" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label asp-for="CheckOutDate" class="form-label small fw-semibold text-muted"></label>
                <input asp-for="CheckOutDate" type="date" min="@minCheckIn" class="form-control" data-date-checkout />
                <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="Guests" class="form-label small fw-semibold text-muted"></label>
                <select asp-for="Guests" class="form-select">
                    <option value="">Any</option>
                    @for (var i = 1; i <= 6; i++)
                    {
                        <option value="@i">@i+ @(i == 1 ? "Guest" : "Guests")</option>
                    }
                </select>
                <span asp-validation-for="Guests" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="RoomType" class="form-label small fw-semibold text-muted"></label>
                <select asp-for="RoomType" asp-items="Html.GetEnumSelectList<RoomType>()" class="form-select">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-12 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-hotel-primary flex-grow-1">Search</button>
                @if (Model.HasSearched)
                {
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-hotel-outline" title="Clear filters">Reset</a>
                }
            </div>
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-warning mt-3 mb-0 small"></div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="small text-muted mb-0">
            Showing <strong>@Model.Rooms.Count</strong> available @(Model.Rooms.Count == 1 ? "room" : "rooms")
        </p>
    </div>

    @if (Model.Rooms.Count == 0)
    {
        <div class="summary-card text-center py-5">
            <h2 class="h4 mb-2">No rooms match your current search</h2>
            <p class="text-muted mb-4">Try adjusting your check-in/check-out dates, lowering the guest count, or viewing all room types.</p>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-hotel-outline">Show All Available Rooms</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var room in Model.Rooms)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="hotel-card">
                        <div class="room-image-wrap">
                            <img src="@room.ImageUrl" data-fallback="/images/room-placeholder.svg" alt="@room.Name" loading="lazy" />
                            <span class="room-type-badge">@room.RoomType</span>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <h2 class="h5 mb-0">@room.Name</h2>
                                <span class="small text-muted text-nowrap">Room @room.RoomNumber</span>
                            </div>
                            <p class="small text-muted mb-2">Up to @room.Capacity guests &middot; @room.BedType</p>
                            <p class="small text-muted room-card-desc mb-3">@room.ShortDescription</p>

                            @if (room.Amenities.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var amenity in room.Amenities.Take(4))
                                    {
                                        <span class="amenity-chip">@amenity</span>
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center pt-3 mt-auto border-top">
                                <div>
                                    <span class="price-figure">@CurrencyFormatter.FormatNightlyRate(room.PricePerNight)</span>
                                    <span class="small text-muted">/ night</span>
                                </div>
                                <a asp-controller="Rooms"
                                   asp-action="Details"
                                   asp-route-id="@room.Id"
                                   asp-route-checkInDate="@(Model.CheckInDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-checkOutDate="@(Model.CheckOutDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-guests="@Model.Guests"
                                   class="btn btn-hotel-primary btn-sm">View Details</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
