@model HotelBookingSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="summary-card p-4 p-md-5">
                <p class="eyebrow mb-1">Welcome Back</p>
                <h1 class="display-6 mb-2">Sign In</h1>
                <p class="text-muted small mb-4">Access your reservations or manage your stay at Aarohan Residency.</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                    </div>

                    <button type="submit" class="btn btn-hotel-primary w-100 mb-3">Sign In</button>

                    <p class="small text-muted text-center mb-0">
                        New to Aarohan Residency?
                        <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl"
                           class="text-decoration-none fw-semibold" style="color: var(--accent-bronze-dark);">Create an account</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
