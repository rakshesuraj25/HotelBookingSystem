@{
    ViewData["Title"] = "Access Denied";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="summary-card text-center p-5">
                <p class="eyebrow mb-2">Authorization</p>
                <h1 class="display-6 mb-3">Access Denied</h1>
                <p class="text-muted mb-4">
                    You do not have permission to view this page. If you believe this is an error, please sign in with an authorized account.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-hotel-primary">Return Home</a>
            </div>
        </div>
    </div>
</section>
