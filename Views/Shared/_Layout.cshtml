@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aarohan Residency</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBookingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg hotel-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="hotel-brand" asp-controller="Home" asp-action="Index">
                    <span class="hotel-brand-mark" aria-hidden="true">A</span>
                    <span>Aarohan Residency</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#hotelMainNav"
                        aria-controls="hotelMainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="hotelMainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Rooms" ? "active" : "")"
                               asp-controller="Rooms" asp-action="Index">Rooms</a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Bookings" ? "active" : "")"
                                   asp-controller="Bookings" asp-action="MyBookings">My Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                                   asp-controller="Account" asp-action="Profile">Profile</a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" style="color: var(--accent-bronze-dark);"
                                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Panel</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-center">
                        @if (isAuthenticated)
                        {
                            <span class="small text-muted me-lg-2">Hello, <strong>@User.Identity?.Name</strong></span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-hotel-outline btn-sm">Sign Out</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-hotel-outline btn-sm">Sign In</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-hotel-primary btn-sm">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="hotel-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="mb-3">Aarohan Residency</h5>
                    <p class="small mb-2">
                        A welcoming Indian hotel offering comfortable stays, modern amenities, and attentive hospitality.
                    </p>
                    <p class="small mb-0">
                        12 Residency Road, City Centre (Placeholder Address)<br />
                        reservations@aarohanresidency.example &middot; +91 00000 00000
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="mb-3">Explore</h6>
                    <ul class="list-unstyled small d-grid gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Rooms" asp-action="Index">Rooms &amp; Suites</a></li>
                        <li><a asp-controller="Bookings" asp-action="MyBookings">My Bookings</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-5">
                    <h6 class="mb-3">Guest Policies</h6>
                    <ul class="list-unstyled small d-grid gap-2 mb-0">
                        <li>Check-in: From 3:00 PM &middot; Check-out: Until 11:00 AM</li>
                        <li>Complimentary cancellation up to 24 hours prior to arrival.</li>
                        <li>Smoke-free property &middot; 24-hour front desk &amp; concierge.</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small gap-2">
                <span>&copy; @DateTime.UtcNow.Year Aarohan Residency. All rights reserved.</span>
                <span>Direct Reservations &middot; Best Rate Guaranteed</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
